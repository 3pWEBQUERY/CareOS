{
  "name": "careos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node database/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file=.env.local database/migrate.mjs",
    "db:seed": "node --env-file=.env.local database/seed-demo.mjs",
    "styles:mobile-type": "node scripts/build-mobile-type.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "test": "node --import ./scripts/node-ts/register.mjs --experimental-transform-types --no-warnings=ExperimentalWarning --test tests/*.test.ts",
    "test:db": "node --import ./scripts/node-ts/register.mjs --import ./tests/support/neon-pg.mjs --experimental-transform-types --no-warnings=ExperimentalWarning --test --test-concurrency=1 tests/db/*.test.ts",
    "test:db:setup": "node --import ./tests/support/neon-pg.mjs database/migrate.mjs",
    "db:seed:roster": "node --import ./scripts/node-ts/register.mjs --env-file=.env.local database/seed-roster.ts",
    "test:db:seed": "node --import ./scripts/node-ts/register.mjs --import ./tests/support/neon-pg.mjs database/seed-roster.ts",
    "test:e2e": "playwright test",
    "test:e2e:setup": "node --import ./tests/support/neon-pg.mjs database/migrate.mjs && node --import ./scripts/node-ts/register.mjs --import ./tests/support/neon-pg.mjs database/seed-roster.ts && node --import ./tests/support/neon-pg.mjs database/seed-demo.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@dnd-kit/core": "^6.3.1",
    "@mistralai/mistralai": "2.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "date-holidays": "3.37.0",
    "fast-xml-parser": "^5.11.2",
    "next": "16.4.0",
    "nodemailer": "^10.0.13",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swissqrbill": "^4.4.2",
    "three": "^0.186.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
