# ── Datenbank (Railway Postgres: ${{Postgres.DATABASE_URL}}) ──
DATABASE_URL="postgresql://careos:careos@localhost:5432/careos"

# ── Anwendung ──
APP_URL="http://localhost:3000"
TZ="Europe/Zurich"
# Sitzungsdauer in Stunden (gleitend)
SESSION_HOURS=12

# ── Railway Bucket (S3-kompatibel) ──
# In Railway als Referenzen setzen: ${{Bucket.BUCKET}}, ${{Bucket.ENDPOINT}} usw.
BUCKET=""
ENDPOINT=""
REGION="auto"
ACCESS_KEY_ID=""
SECRET_ACCESS_KEY=""
# URL-Art laut Tab «Credentials» des Buckets: virtual-hosted (neue Railway Buckets) → false, path-style → true
S3_FORCE_PATH_STYLE=false

# ── Single Sign-on (optional, OpenID Connect) ──
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_LABEL="Mit Microsoft anmelden"

# ── Passkeys (WebAuthn) ──
# Standard: Hostname aus APP_URL
WEBAUTHN_RP_ID=""

# ── CareOS AI (optional, Phase 5) ──
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# ── Web Push (optional) ──
# Schlüsselpaar erzeugen: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Kontaktadresse für Push-Dienste (mailto: oder https:)
VAPID_SUBJECT="mailto:it@example.ch"

# Demodaten beim ersten Start einspielen (nur Test-/Pilotumgebungen)
SEED_DEMO=false

# Erststart ohne Demodaten (nur auf leerer Datenbank, siehe docs/RAILWAY.md)
INIT_ORG_NAME=""
INIT_ADMIN_EMAIL=""
INIT_ADMIN_PASSWORD=""
INIT_ADMIN_FIRST_NAME=""
INIT_ADMIN_LAST_NAME=""
INIT_LOCATION_NAME=""
# Anzahl Wohngruppen (Standard 4) und Namenspräfix (Standard «Wohngruppe»)
INIT_UNITS=4
INIT_UNIT_NAME=""
# Zufällig erzeugte Mitarbeitende (ohne Passwort, Einladungslinks unter Admin → Benutzer → Einladungen) und Bewohnende (nur Stammdaten)
INIT_STAFF=0
# Platzhalter-Domain der Mitarbeiter-Adressen – vor dem Versand der Einladungen unter der Person ändern
INIT_STAFF_DOMAIN="example.ch"
INIT_RESIDENTS=0
# Gesetzt: reproduzierbare Zufallsdaten
INIT_SEED=""
# Neue Organisationen über /register anlegen lassen (Mehrmandanten-Instanz)
ORG_SIGNUP=false
# Migration beim Start überspringen (nur wenn sie anderweitig läuft)
SKIP_MIGRATE=false

# Verschlüsselung gespeicherter Geheimnisse (min. 32 Zeichen, z. B. openssl rand -hex 32)
APP_SECRET=""

# ── Betrieb und Sicherheit (optional) ──
# Metrik-Endpunkt /api/metrics (Authorization: Bearer <METRICS_TOKEN>); leer = abgeschaltet
METRICS_TOKEN=
# Serverfehler zusätzlich als JSON an einen Webhook senden (https)
ERROR_WEBHOOK_URL=
# Log-Stufe (debug | info | warn | error) und Format (json | pretty; Standard: json in Produktion)
LOG_LEVEL=info
LOG_FORMAT=
# Content-Security-Policy: nur melden statt blockieren; zusätzliche Quellen (durch Leerzeichen getrennt, https://…)
CSP_REPORT_ONLY=false
CSP_IMG_SRC=
CSP_CONNECT_SRC=
CSP_FRAME_SRC=
CSP_MEDIA_SRC=
# Serverseitige Verschlüsselung beim Upload (AES256 | aws:kms) – nicht für Railway Buckets (immer verschlüsselt, Header nicht unterstützt)
S3_SSE=
