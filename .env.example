# ── Datenbank (Railway Postgres: ${{Postgres.DATABASE_URL}}) ──
DATABASE_URL="postgresql://careos:careos@localhost:5432/careos"

# ── Anwendung ──
APP_URL="http://localhost:3000"
TZ="Europe/Zurich"
# Sitzungsdauer in Stunden (gleitend)
SESSION_HOURS=12

# ── Railway Bucket (S3-kompatibel) ──
# In Railway als Referenzen setzen: ${{Bucket.BUCKET}}, ${{Bucket.ENDPOINT}} usw.
BUCKET=""
ENDPOINT=""
REGION="auto"
ACCESS_KEY_ID=""
SECRET_ACCESS_KEY=""
# Railway Buckets erwarten Path-Style-Adressierung
S3_FORCE_PATH_STYLE=true

# ── Single Sign-on (optional, OpenID Connect) ──
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_LABEL="Mit Microsoft anmelden"

# ── Passkeys (WebAuthn) ──
# Standard: Hostname aus APP_URL
WEBAUTHN_RP_ID=""

# ── CareOS AI (optional, Phase 5) ──
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"

# Demodaten beim ersten Start einspielen (nur Test-/Pilotumgebungen)
SEED_DEMO=false
