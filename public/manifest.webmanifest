{
  "id": "/",
  "name": "CareOS",
  "short_name": "CareOS",
  "description": "Die Arbeitsplattform für Pflegeorganisationen: Schicht, Bewohnende, Aufgaben, Übergabe und Team an einem Ort.",
  "lang": "de-CH",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#EEF1F2",
  "theme_color": "#EEF1F2",
  "categories": ["medical", "health", "productivity", "business"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/monochrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Aufgaben", "short_name": "Aufgaben", "url": "/tasks?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Übergabe", "short_name": "Übergabe", "url": "/handover?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Dokumentieren", "short_name": "Dokumentieren", "url": "/residents?pick=notes&source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Medikamentenrunde", "short_name": "Medi-Runde", "url": "/tasks/medround?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "/screenshots/home-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Startseite mit Schicht, Prioritäten und Ablauf (Beispieldaten)" },
    { "src": "/screenshots/residents-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Bewohnerübersicht der Wohngruppe (Beispieldaten)" },
    { "src": "/screenshots/home-narrow.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Meine Schicht auf dem Smartphone (Beispieldaten)" },
    { "src": "/screenshots/tasks-narrow.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Offene Massnahmen (Beispieldaten)" }
  ]
