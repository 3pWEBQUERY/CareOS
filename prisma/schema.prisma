model AssessmentDefinition {
  id          String       @id @default(cuid())
  orgId       String
  key         String
  name        String
  description String?
  items       Json
  intervalDays Int?
  active      Boolean      @default(true)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

model Assessment {
  id         String   @id @default(cuid())
  residentId String
  key        String
  at         DateTime @default(now())
  score      Float?
  result     String?
  answers    Json
  authorId   String
  nextDue    DateTime?
  /// Storno/Korrektur (PRD §35), siehe VitalSign.
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?
  supersedesId String?
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, key])
}

model Wound {
