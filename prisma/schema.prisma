// CareOS – Datenmodell
// Domains gemäss PRD §43: Identity, Organization, Workforce, Resident, Clinical,
// Workflow, Communication, Knowledge, Quality, Platform.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Locale {
  de
  fr
  it
  en
}

enum ThemePref {
  light
  dark
  system
}

enum Terminology {
  resident
  patient
  client
}

enum ReaStatus {
  yes
  no
  unknown
}

enum ResidentStatus {
  active
  absent
  discharged
  deceased
}

enum Priority {
  critical
  important
  routine
}

enum NotificationPriority {
  critical
  action
  info
  social
}

enum TaskStatus {
  planned
  ready
  in_progress
  done
  partial
  skipped
  escalated
}

enum TaskSource {
  careplan
  medication
  assessment
  order
  quality
  manual
  recurring
  event
}

enum ObservationCategory {
  care
  observation
  physician
  relatives
  incident
  handover
  /// Therapiebericht (Physio, Ergo, Logo, Aktivierung)
  therapy
}

enum EntrySource {
  manual
  task
  voice
  ai
  system
}

enum CarePlanStatus {
  draft
  active
  archived
}

enum MedicationKind {
  regular
  prn
  temporary
}

enum AdministrationStatus {
  given
  refused
  omitted
  held
}

enum WoundStatus {
  open
  healing
  closed
}

enum IncidentStage {
  reported
  immediate
  assessment
  followup
  analysis
  closed
}

enum Severity {
  none
  minor
  moderate
  severe
}

enum DocStatus {
  draft
  review
  approved
  archived
}

enum EnrollmentStatus {
  assigned
  in_progress
  completed
  expired
}

enum ShiftStatus {
  planned
  open
  swap_requested
  cancelled
}

enum SchedulePeriodStatus {
  draft
  released
}

enum AbsenceKind {
  vacation
  sick
  training
  compensation
  other
}

enum ApprovalStatus {
  requested
  approved
  rejected
}

enum ConversationKind {
  direct
  group
  team
}

enum ChannelKind {
  company
  location
  unit
  care
  admin
  events
  offers
  custom
}

// ───────────────────────── Organization ─────────────────────────

model Organization {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  terminology   Terminology @default(resident)
  defaultLocale Locale      @default(de)
  timezone      String      @default("Europe/Zurich")
  dataRegion    String      @default("eu-central")
  brandColor    String?
  brandName     String?
  logoFileId    String?
  settings      Json        @default("{}")
  createdAt     DateTime    @default(now())
  /// Aktive Module (PRD §69, src/lib/modules.ts). Bestehende Organisationen: alle an. «core» ist immer aktiv und wird nicht gespeichert.
  modules         String[]  @default(["schedule", "chat", "docs", "learn", "medication", "visit", "therapy", "dictation", "quality", "insights", "ai", "portals"])
  /// Plattform (PRD §42): gesetzt = Anmeldung, Sitzungen und API-Tokens der Organisation werden abgewiesen.
  suspendedAt     DateTime?
  /// «pending» = Registrierung wartet auf Freigabe (ORG_SIGNUP), sonst Grund der Sperre (nur Plattform sichtbar)
  suspendedReason String?

  locations      Location[]
  units          Unit[]
  teams          Team[]
  users          User[]
  roles          Role[]
  residents      Resident[]
  shiftTypes     ShiftType[]
  qualifications Qualification[]
  channels       Channel[]
  conversations  Conversation[]
  documents      Document[]
  courses        Course[]
  incidentTypes  IncidentType[]
  incidents      Incident[]
  files          FileObject[]
  integrations   Integration[]
  webhooks       Webhook[]
  featureFlags   FeatureFlag[]
  apiTokens      ApiToken[]
  vitalLimits    VitalThreshold[]
  careDomains    CareDomain[]
  assessmentDefs AssessmentDefinition[]
  tasks          Task[]
  events         DomainEvent[]
  formDefinitions FormDefinition[]
  taskTemplates  TaskTemplate[]
  portalAccounts PortalAccount[]
}

model Location {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  org     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  units   Unit[]
  roles   RoleAssignment[]
  channel Channel[]

  @@index([orgId])
}

model Unit {
  id         String   @id @default(cuid())
  orgId      String
  locationId String
  name       String
  shortName  String?
  kind       String   @default("ward")
  /// Telefon des Bereichs (Stationszimmer); im Bewohnerportal unter «Hilfe und Kontakt», sonst Telefon des Standorts
  phone      String?
  createdAt  DateTime @default(now())

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  rooms      Room[]
  residents  Resident[]
  teams      Team[]
  roles      RoleAssignment[]
  shifts     Shift[]
  handovers  Handover[]
  tasks      Task[]
  channels   Channel[]
  incidents  Incident[]
  taskTemplates TaskTemplate[]
  shiftAssignments ShiftAssignment[]
  schedulePeriods  SchedulePeriod[]
  scheduleProposals ScheduleProposal[]

  @@index([orgId])
  @@index([locationId])
}

model Room {
  id        String     @id @default(cuid())
  unitId    String
  number    String
  beds      Int        @default(1)
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  residents Resident[]

  @@unique([unitId, number])
}

model Team {
  id        String       @id @default(cuid())
  orgId     String
  unitId    String?
  name      String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit      Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  members   TeamMember[]

  @@index([orgId])
}

model TeamMember {
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id           String    @id @default(cuid())
  orgId        String
  email        String    @unique
  firstName    String
  lastName     String
  initials     String
  jobTitle     String?
  employeeNo   String?
  phone        String?
  passwordHash String?
  locale       Locale    @default(de)
  theme        ThemePref @default(light)
  mfaSecret    String?
  mfaEnabled   Boolean   @default(false)
  ssoSubject   String?   @unique
  avatarFileId String?
  active       Boolean   @default(true)
  primaryUnitId String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  org             Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions        Session[]
  passkeys        Passkey[]
  roles           RoleAssignment[]
  teams           TeamMember[]
  shifts          Shift[]
  absences        Absence[]           @relation("AbsenceUser")
  qualifications  UserQualification[]
  notifications   Notification[]
  acknowledgements Acknowledgement[]
  enrollments     Enrollment[]
  certificates    Certificate[]
  conversationMembers ConversationMember[]
  messages        Message[]
  posts           Post[]
  primaryResidents Resident[]         @relation("PrimaryNurse")
  /// Web Push (PRD §25): Prioritäten, für die Push-Benachrichtigungen gesendet werden (critical | action | info | social).
  pushPriorities   String[]           @default(["critical", "action"])
  pushSubscriptions PushSubscription[]
  shiftAssignments  ShiftAssignment[]
  /// Dienstplanung: Beschäftigungsgrad in Prozent (Soll-Stunden = Wochenstunden × Pensum).
  employmentPct     Int                @default(100)
  shiftWishes       ShiftWish[]
  /// Benachrichtigungen je Art (PRD §25, src/lib/notify-prefs.ts): { kinds: { <art>: { app, push } }, offDutyPush }.
  notificationPrefs Json              @default("{}")
  /// Personenverzeichnis (PRD §55): dienstliche Nummer (Stationstelefon, DECT) – für alle Mitarbeitenden sichtbar.
  workPhone        String?
  /// `phone` ist die private Nummer: sichtbar für die Person selbst, Leitung/HR im Bereich – und für alle nur, wenn die Person sie freigibt.
  phoneShared      Boolean            @default(false)
  /// Selbstregistrierung (PRD §33): gesetzt, solange die Anfrage auf Freigabe wartet (Konto dabei inaktiv). Freigabe setzt null.
  pendingSince     DateTime?
  /// Angaben der Registrierung: { note, consentAt, approvedAt?, approvedById? } – nur Admin → Benutzer → Anfragen.
  registration     Json?
  /// Plattform-Betrieb (PRD §42): «operator» = Zugang zu /platform (Organisationen, Module, Sperren). Keine klinischen Rechte.
  platformRole        String?
  /// Kontoart (PRD §60 Ärzteportal): staff | external_physician. Externe Konten haben in der Stationsapp keine
  /// Berechtigungen (getCtx ohne Grants) und sehen im Ärzteportal /md nur zugeordnete Personen (ResidentPhysician).
  kind             String             @default("staff")
  physicianOf      ResidentPhysician[]

  @@index([orgId])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  mfaPassed   Boolean   @default(false)
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  /// Anmeldeverfahren: password | passkey | sso (SSO ist von der MFA-Pflicht ausgenommen, PRD §33).
  method      String    @default("password")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthChallenge {
  id        String   @id @default(cuid())
  userId    String?
  challenge String
  kind      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Role {
  id          String           @id @default(cuid())
  orgId       String
  key         String
  name        String
  description String?
  permissions String[]
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]

  @@unique([orgId, key])
}

/// Rolle mit optionalem Geltungsbereich. Ohne Standort/Bereich gilt sie für die ganze Organisation.
model RoleAssignment {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  locationId String?
  unitId     String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiToken {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  tokenHash   String    @unique
  scopes      String[]
  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  /// Ablaufdatum (Developer-Portal: Pflicht für persönliche Tokens). null = unbefristet (Integrations-Tokens).
  expiresAt   DateTime?
  /// Persönliches Token (Developer-Portal): Scopes nur innerhalb der eigenen Berechtigungen, bei jedem Aufruf geprüft.
  personal    Boolean   @default(false)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([createdById])
}

/// Kalender-Abo (PRD §19): geheime Adresse /api/ical/<token> mit den eigenen Diensten. Gespeichert nur als SHA-256-Hash;
/// höchstens ein aktives Token je Person (neu erzeugen widerruft das bisherige).
model CalendarToken {
  id         String    @id @default(cuid())
  orgId      String
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

// ───────────────────────── Workforce ─────────────────────────

model ShiftType {
  id      String       @id @default(cuid())
  orgId   String
  code    String
  name    String
  start   String
  end     String
  color   String       @default("accent")
  /// Dienstplanung: unbezahlte Pause in Minuten (Arbeitszeit = Dauer − Pause, src/lib/roster).
  breakMinutes Int     @default(0)
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shifts  Shift[]
  wishes  ShiftWish[]

  @@unique([orgId, code])
}

model Shift {
  id          String      @id @default(cuid())
  unitId      String
  userId      String?
  shiftTypeId String
  date        DateTime    @db.Date
  status      ShiftStatus @default(planned)
  note        String?
  requiredQualification String?
  createdAt   DateTime    @default(now())

  unit      Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  shiftType ShiftType     @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  swaps     SwapRequest[]

  @@index([unitId, date])
  @@index([userId, date])
}

model SwapRequest {
  id           String         @id @default(cuid())
  shiftId      String
  requesterId  String
  takerId      String?
  status       ApprovalStatus @default(requested)
  note         String?
  createdAt    DateTime       @default(now())
  decidedById  String?
  decidedAt    DateTime?
  /// Schedule: Zeitpunkt, an dem die übernehmende Person zugesagt hat (danach Freigabe durch Leitung).
  acceptedAt   DateTime?

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

model Absence {
  id          String         @id @default(cuid())
  userId      String
  kind        AbsenceKind
  from        DateTime       @db.Date
  to          DateTime       @db.Date
  status      ApprovalStatus @default(requested)
  note        String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  user User @relation("AbsenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Dienstplanung (PEP-artig): Monat je Bereich. Ohne Eintrag gilt ein Monat als freigegeben.
/// Entwurf = Dienste sind nur für die Leitung sichtbar; Freigabe benachrichtigt das Team.
model SchedulePeriod {
  id           String               @id @default(cuid())
  orgId        String
  unitId       String
  /// Erster Tag des Monats
  month        DateTime             @db.Date
  status       SchedulePeriodStatus @default(draft)
  releasedAt   DateTime?
  releasedById String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, month])
  @@index([orgId, status])
}

/// Dienstwunsch einer Person für einen Tag: frei oder ein bestimmter Dienst.
model ShiftWish {
  id          String     @id @default(cuid())
  orgId       String
  userId      String
  date        DateTime   @db.Date
  /// off | shift
  kind        String
  shiftTypeId String?
  note        String?
  createdAt   DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftType ShiftType? @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([orgId, date])
}

/// Planungsvorschlag für einen Monat (KI oder automatische Planung). Wird erst nach Prüfung übernommen.
model ScheduleProposal {
  id           String    @id @default(cuid())
  orgId        String
  unitId       String
  month        DateTime  @db.Date
  /// ai | auto | copy
  source       String
  /// fill = nur leere Zellen, replace = Monat ab heute neu planen
  mode         String
  /// running | ready | failed | applied | discarded
  status       String    @default("running")
  instructions String?
  /// Vorgeschlagene Zellen [{ u, d, c }] (Person, Tag YYYY-MM-DD, Dienstcode oder null = frei)
  cells        Json      @default("[]")
  /// Kennzahlen, Hinweise der KI, Korrekturen der Regelprüfung
  summary      Json      @default("{}")
  error        String?
  model        String?
  createdById  String
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?
  decidedById  String?

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, month])
}

model Qualification {
  id     String              @id @default(cuid())
  orgId  String
  name   String
  level  Int                 @default(1)
  org    Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users  UserQualification[]
}

model UserQualification {
  userId          String
  qualificationId String
  validUntil      DateTime?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  @@id([userId, qualificationId])
}

// ───────────────────────── Resident ─────────────────────────

model Resident {
  id             String         @id @default(cuid())
  orgId          String
  unitId         String
  roomId         String?
  firstName      String
  lastName       String
  birthDate      DateTime       @db.Date
  sex            String?
  careLevel      Int?
  physician      String?
  primaryNurseId String?
  rea            ReaStatus      @default(unknown)
  allergies      String[]
  risks          String[]
  diet           String?
  mobility       String?
  importantNotes String?
  insuranceNo    String?
  status         ResidentStatus @default(active)
  admittedAt     DateTime       @default(now())
  dischargedAt   DateTime?
  photoFileId    String?
  /// Löschkonzept (PRD §36): Zeitpunkt der Anonymisierung nach Ablauf der Aufbewahrungsfrist oder manuell.
  anonymisedAt   DateTime?
  createdAt      DateTime       @default(now())
  /// Versionsprüfung bei Stammdaten (PRD §32 Konflikterkennung).
  updatedAt      DateTime       @default(now()) @updatedAt

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id])
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  primaryNurse User?        @relation("PrimaryNurse", fields: [primaryNurseId], references: [id], onDelete: SetNull)

  contacts        Contact[]
  episodes        CareEpisode[]
  appointments    Appointment[]
  observations    Observation[]
  vitals          VitalSign[]
  vitalLimits     VitalThreshold[]
  carePlans       CarePlan[]
  interventions   Intervention[]
  assessments     Assessment[]
  wounds          Wound[]
  nutrition       NutritionProfile?
  intake          IntakeLog[]
  medications     Medication[]
  administrations MedicationAdministration[]
  tasks           Task[]
  handoverEntries HandoverEntry[]
  incidents       Incident[]
  files           ResidentFile[]
  visits          Visit[]
  visitQuestions  VisitQuestion[]
  shiftAssignments ShiftAssignment[]
  portalAccesses  PortalAccess[]
  portalThreads   PortalThread[]
  portalUpdates   PortalUpdate[]
  visitRequests   VisitRequest[]
  /// Zugeordnete Ärztinnen und Ärzte mit Konto (Freitext `physician` bleibt für Personen ohne Konto)
  physicians      ResidentPhysician[]
  therapyPlans    TherapyPlan[]

  @@index([orgId, unitId])
}

model Contact {
  id          String   @id @default(cuid())
  residentId  String
  name        String
  relation    String
  phone       String?
  email       String?
  isEmergency Boolean  @default(false)
  isLegalRep  Boolean  @default(false)
  notes       String?
  resident    Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  portalAccesses PortalAccess[]
}

model CareEpisode {
  id          String    @id @default(cuid())
  residentId  String
  start       DateTime
  end         DateTime?
  reason      String
  /// stay = Aufenthalt in einem Bereich (Eintritt, nach Verlegung neu), absence = Abwesenheit (Spital, Ferien …) bis zur Rückkehr
  kind        String    @default("stay")
  /// Bereich des Aufenthalts (stay); bei älteren Einträgen leer
  unitId      String?
  /// Geplante Rückkehr (absence), optional
  expectedEnd DateTime?
  createdById String?
  resident    Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, end])
}

model Appointment {
  id          String   @id @default(cuid())
  residentId  String
  at          DateTime
  title       String
  kind        String   @default("other")
  place       String?
  notes       String?
  done        Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  /// Therapieeinheit eines Therapieplans (kind = therapy)
  therapyPlanId String?
  resident    Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, at])
}

model ResidentFile {
  id         String     @id @default(cuid())
  residentId String
  fileId     String
  title      String
  category   String     @default("other")
  createdAt  DateTime   @default(now())
  /// Angehörigenportal (PRD §60): einzeln für Angehörige freigegeben (nur nicht klinische Kategorien, src/lib/portal/policy.ts).
  portalShared     Boolean   @default(false)
  portalSharedAt   DateTime?
  portalSharedById String?
  /// Externer Bericht (PRD §41): Austrittsbericht oder Bericht einer Klinik, eingegangen über eine Schnittstelle.
  external   Boolean    @default(false)
  /// Eingang: fhir (POST /api/fhir/DocumentReference); null = in der App hochgeladen
  receivedVia String?
  /// Art des externen Berichts: discharge | clinic
  reportKind String?
  /// Datum des Berichts laut Absender (DocumentReference.date)
  reportDate DateTime?
  resident   Resident   @relation(fields: [residentId], references: [id], onDelete: Cascade)
  file       FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Clinical ─────────────────────────

/// Pflegebericht / Verlaufseintrag. Korrekturen erzeugen einen neuen Eintrag mit supersedesId.
model Observation {
  id           String              @id @default(cuid())
  residentId   String
  at           DateTime            @default(now())
  category     ObservationCategory
  text         String
  authorId     String
  source       EntrySource         @default(manual)
  aiAssisted   Boolean             @default(false)
  important    Boolean             @default(false)
  taskId       String?
  supersedesId String?
  structured   Json?
  createdAt    DateTime            @default(now())

  resident   Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)
  supersedes Observation? @relation("Correction", fields: [supersedesId], references: [id])
  correctedBy Observation[] @relation("Correction")

  @@index([residentId, at])
  /// Korrekturen nachschlagen («correctedBy»): sonst Vollscan über alle Verlaufseinträge auf jeder Akte (PRD §66)
  @@index([supersedesId])
}

model VitalSign {
  id           String   @id @default(cuid())
  residentId   String
  at           DateTime @default(now())
  recordedById String
  sys          Int?
  dia          Int?
  pulse        Int?
  temp         Float?
  spo2         Int?
  glucose      Float?
  weight       Float?
  pain         Int?
  respRate     Int?
  note         String?
  /// Storno/Korrektur (PRD §35): nie überschreiben. Stornierte Werte bleiben sichtbar, fliessen aber nicht in Hinweise/Trends (`LIVE` in lib/vitals.ts).
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?
  /// Korrektur ersetzt diesen (stornierten) Eintrag.
  supersedesId String?
  /// Organisationseigene Vitalparameter (Admin → Klinische Konfiguration), Schlüssel → Zahl.
  extra        Json?
  /// Auffälliger Wert gesehen bzw. Massnahme eingeleitet (PRD §14 «ohne Alarmflut»): nimmt den Wert aus «Kritisch» auf Home und aus dem Akten-Hinweis.
  reviewedAt   DateTime?
  reviewedById String?
  /// seen | action
  reviewKind   String?
  /// Eingeleitete Massnahme (bei reviewKind = action, zusätzlich als Verlaufseintrag dokumentiert)
  reviewNote   String?
  resident     Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, at])
}

/// Grenzwert je Organisation (residentId leer) oder individuell je Bewohner.
