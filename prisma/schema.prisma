  residentId     String
  bodySite       String
  kind           String
  classification String?
  origin         String?
  status         WoundStatus        @default(open)
  startedAt      DateTime           @default(now())
  closedAt       DateTime?
  createdById    String
  resident       Resident           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  entries        WoundAssessment[]
}

model WoundAssessment {
  id          String    @id @default(cuid())
  woundId     String
  at          DateTime  @default(now())
  lengthMm    Float?
  widthMm     Float?
  depthMm     Float?
  exudate     String?
  tissue      String?
  edge        String?
  pain        Int?
  description String?
  treatment   String?
  material    String?
  nextChange  DateTime?
  photoIds    String[]
  authorId    String
  /// Storno/Korrektur (PRD §35), siehe VitalSign.
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?
  supersedesId String?
  wound       Wound     @relation(fields: [woundId], references: [id], onDelete: Cascade)
}

model NutritionProfile {
  residentId    String   @id
  dietForm      String?
  texture       String?
  intolerances  String[]
  supplements   String?
  swallowing    String?
  fluidTargetMl Int?
  notes         String?
  updatedAt     DateTime @updatedAt
  resident      Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

model IntakeLog {
  id         String   @id @default(cuid())
  residentId String
  at         DateTime @default(now())
  kind       String
  item       String?
  amountMl   Int?
  portion    Float?
  authorId   String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, at])
}

// ───────────────────────── Medication ─────────────────────────

model Medication {
  id                  String         @id @default(cuid())
  residentId          String
  name                String
  form                String?
  route               String         @default("p.o.")
  indication          String?
  kind                MedicationKind @default(regular)
  /// Zeitpunkte HH:MM und Dosis je Zeitpunkt (gleiche Länge).
  times               String[]
  doses               String[]
  prnDose             String?
  prnMaxPerDay        Int?
  prnMinIntervalH     Int?
  startDate           DateTime       @default(now())
  endDate             DateTime?
  prescriber          String?
  requiresDoubleCheck Boolean        @default(false)
  stock               Int?
  stockUnit           String?
  notes               String?
  active              Boolean        @default(true)
  createdById         String
  createdAt           DateTime       @default(now())
  stoppedAt           DateTime?
  stoppedById         String?
  /// Codes für Interaktionsprüfung und Katalog (PRD §13.1, §58): ATC (WHO, z. B. B01AA04), GTIN (GS1, Schweiz 7680…)
  atc                 String?
  gtin                String?
  /// Herkunft: written (ärztlich erfasst) | phone | verbal (telefonisch/mündlich angeordnet, Gegenzeichnung nötig)
  orderSource         String         @default("written")
  /// Anordnende Ärztin/anordnender Arzt mit Konto (bei telefonischer/mündlicher Anordnung)
  orderedById         String?
  /// Frist für die ärztliche Gegenzeichnung; gesetzt bei phone/verbal
  confirmDueAt        DateTime?
  confirmedById       String?
  confirmedAt         DateTime?
  /// Eskalation nach Fristablauf (einmalig)
  confirmEscalatedAt  DateTime?

  resident        Resident                   @relation(fields: [residentId], references: [id], onDelete: Cascade)
  administrations MedicationAdministration[]
  stockEntries    MedicationStockEntry[]

  @@index([residentId])
}

model MedicationAdministration {
  id            String               @id @default(cuid())
  medicationId  String
  residentId    String
  /// Geplanter Zeitpunkt (null bei Reserve)
  scheduledFor  DateTime?
  status        AdministrationStatus
  dose          String?
  at            DateTime             @default(now())
  byId          String
  checkedById   String?
  note          String?
  effectAt      DateTime?
  effectNote    String?
  voidedAt      DateTime?
  voidedById    String?

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  resident   Resident   @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, scheduledFor])
  @@index([medicationId, at])
}

// ───────────────────────── Workflow ─────────────────────────

model Task {
  id             String     @id @default(cuid())
  orgId          String
  unitId         String
  residentId     String?
  title          String
  description    String?
  category       String
  dueAt          DateTime
  durationMin    Int        @default(10)
  priority       Priority   @default(routine)
  status         TaskStatus @default(planned)
  source         TaskSource @default(manual)
  sourceId       String?
  assigneeId     String?
  createdById    String?
  completedById  String?
  completedAt    DateTime?
  note           String?
  createdAt      DateTime   @default(now())
  /// Systemabschluss ohne Quittung (PRD §12, §43): shift_end = zeitgebundene Routineaufgabe nach Ende der Folgeschicht
  /// nicht erledigt und übergeben; absence = während einer Abwesenheit pausiert (wird bei der Rückkehr wieder geöffnet).
  autoClosed     String?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit     Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resident Resident?    @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId, dueAt])
  @@index([unitId, dueAt])
  @@index([residentId, dueAt])
}

enum TaskRhythm {
  daily
  weekly
  monthly
}

/// Vorlage für wiederkehrende Aufgaben (PRD §12.1, §45): erzeugt in ensureTasksForDay Aufgaben mit source recurring, sourceId = id.
model TaskTemplate {
  id          String     @id @default(cuid())
  orgId       String
  unitId      String
  residentId  String?
  title       String
  description String?
  category    String
  rhythm      TaskRhythm @default(daily)
  /// alle n Tage / Wochen / Monate (1 = jede/n)
  every       Int        @default(1)
  /// Wochentage 0 = So … 6 = Sa (nur weekly)
  weekdays    Int[]
  /// Tag im Monat 1–31 (nur monthly; in kürzeren Monaten der letzte Tag)
  monthDay    Int?
  /// Zeitpunkte HH:MM
  times       String[]
  startDate   DateTime   @db.Date
  endDate     DateTime?  @db.Date
  durationMin Int        @default(10)
  priority    Priority   @default(routine)
  assigneeId  String?
  active      Boolean    @default(true)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, active])
}

/// Merker der Aufgabenerzeugung je Bereich und Tag (PRD §66 Skalierbarkeit): gilt über alle Instanzen.
/// ensureTasksForDay erzeugt neu, wenn kein Eintrag besteht oder er älter als 10 Minuten ist; invalidateTaskGeneration löscht ihn.
/// Gleichzeitige Erzeugung wird mit pg_advisory_xact_lock serialisiert; Duplikate verhindert @@unique([source, sourceId, dueAt]) an Task.
model TaskGeneration {
  unitId String
  day    DateTime @db.Date
  at     DateTime @default(now())

  @@id([unitId, day])
}

model Handover {
  id          String          @id @default(cuid())
  unitId      String
  shiftCode   String
  date        DateTime        @db.Date
  authorId    String?
  note        String?
  submittedAt DateTime?
  createdAt   DateTime        @default(now())
  unit        Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  entries     HandoverEntry[]

  @@unique([unitId, shiftCode, date])
}

model HandoverEntry {
  id         String   @id @default(cuid())
  handoverId String
  residentId String
  watch      String?
  open       String?
  important  Boolean  @default(false)
  authorId   String
  updatedAt  DateTime @updatedAt
  handover   Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([handoverId, residentId])
}

/// Bewohnerzuordnung pro Dienst (PRD §7, §70 «Für wen ist sie verantwortlich?»): wer betreut wen in welcher Schicht.
/// Schicht wie bei Handover: Code + Startdatum (Nachtdienst nach Mitternacht gehört zum Vortag). Lesen über src/lib/assignment.ts.
model ShiftAssignment {
  id          String   @id @default(cuid())
  orgId       String
  unitId      String
  shiftCode   String
  date        DateTime @db.Date
  residentId  String
  userId      String
  createdById String
  createdAt   DateTime @default(now())

  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([unitId, shiftCode, date, residentId, userId])
  @@index([unitId, date, shiftCode])
  @@index([userId, date])
}

/// Generische Kenntnisnahme: Übergabe, Mitteilung, Dokumentversion, wichtige Beobachtung.
model Acknowledgement {
  id          String   @id @default(cuid())
  userId      String
  subjectType String
  subjectId   String
  version     String   @default("")
  at          DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectType, subjectId, version])
  @@index([subjectType, subjectId])
}

// ───────────────────────── Communication ─────────────────────────

model Channel {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  kind        ChannelKind
  description String?
  locationId  String?
  unitId      String?
  postRoles   String[]
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  unit     Unit?        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  posts    Post[]
}

model Post {
  id          String    @id @default(cuid())
  channelId   String
  authorId    String
  title       String
  body        String
  important   Boolean   @default(false)
  requireAck  Boolean   @default(false)
  pinned      Boolean   @default(false)
  eventAt     DateTime?
  eventPlace  String?
  fileIds     String[]
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  /// Zielgruppe (PRD §45): Rollen-Schlüssel; leer = alle Mitarbeitenden des Kanals. Gilt für Sichtbarkeit, Benachrichtigung und Lesebestätigung.
  audienceRoles String[] @default([])

  channel  Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id])
  comments PostComment[]

  @@index([channelId, publishedAt])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String           @id @default(cuid())
  orgId       String
  kind        ConversationKind
  name        String?
  clinical    Boolean          @default(false)
  createdById String
  createdAt   DateTime         @default(now())
  lastMessageAt DateTime       @default(now())

  org      Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  muted          Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  fileIds        String[]
  mentions       String[]
  createdAt      DateTime          @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User              @relation(fields: [authorId], references: [id])
  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
}

model MessageReaction {
  messageId String
  userId    String
  emoji     String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  priority  NotificationPriority
  kind      String
  title     String
  body      String?
  href      String?
  groupKey  String?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  /// Gerätebezeichnung (Browser · Betriebssystem) für die Anzeige im Profil.
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── Knowledge ─────────────────────────

model Document {
  id          String            @id @default(cuid())
  orgId       String
  title       String
  category    String
  tags        String[]
  status      DocStatus         @default(draft)
  ownerId     String
  requireAck  Boolean           @default(false)
  validFrom   DateTime?
  validUntil  DateTime?
  currentVersion String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  /// Zielgruppe (PRD §45): Rollen-Schlüssel; leer = alle mit docs.read. Bestimmt Benachrichtigung und Kenntnisnahme; lesen dürfen weiterhin alle mit docs.read.
  audienceRoles String[]        @default([])
  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions    DocumentVersion[]

  @@index([orgId, category])
}

model DocumentVersion {
  id           String    @id @default(cuid())
  documentId   String
  version      String
  body         String
  fileId       String?
  changeNote   String?
  critical     Boolean   @default(false)
  authorId     String
  approvedById String?
  approvedAt   DateTime?
  /// Zur Freigabe eingereicht (Docs). Ohne approvedAt und ohne submittedAt = Entwurf.
  submittedAt  DateTime?
  /// Assign (PRD §49): gewählte Person für die Freigabe (docs.approve). null = alle mit docs.approve.
  reviewerId   String?
  /// Frist der Freigabe; danach eskaliert der Job «escalations» einmal (reviewEscalatedAt).
  reviewDueAt  DateTime?
  reviewEscalatedAt DateTime?
  createdAt    DateTime  @default(now())
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

model Course {
  id             String         @id @default(cuid())
  orgId          String
  title          String
  description    String?
  category       String         @default("general")
  mandatory      Boolean        @default(false)
  validityMonths Int?
  estMinutes     Int            @default(30)
  audienceRoles  String[]
  published      Boolean        @default(true)
  createdAt      DateTime       @default(now())
  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  modules        CourseModule[]
  enrollments    Enrollment[]
}

model CourseModule {
  id       String  @id @default(cuid())
  courseId String
  order    Int
  kind     String
  title    String
  body     String?
  fileId   String?
  videoUrl String?
  quiz     Json?
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id          String           @id @default(cuid())
  courseId    String
  userId      String
  status      EnrollmentStatus @default(assigned)
  assignedAt  DateTime         @default(now())
  dueAt       DateTime?
  doneModules String[]
  score       Float?
  completedAt DateTime?
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model Certificate {
  id        String    @id @default(cuid())
  userId    String
  courseId  String?
  title     String
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?
  fileId    String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Quality ─────────────────────────

model IncidentType {
  id        String       @id @default(cuid())
  orgId     String
  key       String
  name      String
  /// Folgeprozess: [{ title, category, offsetMin, durationMin }]
  workflow  Json         @default("[]")
  active    Boolean      @default(true)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  incidents Incident[]

  @@unique([orgId, key])
}

model Incident {
  id               String        @id @default(cuid())
  orgId            String
  unitId           String
  residentId       String?
  typeId           String
  occurredAt       DateTime
  place            String?
  description      String
  immediateActions String?
  severity         Severity      @default(none)
  nearMiss         Boolean       @default(false)
  stage            IncidentStage @default(reported)
  assessment       String?
  analysis         String?
  conclusion       String?
  reportedById     String
  closedById       String?
  closedAt         DateTime?
  createdAt        DateTime      @default(now())

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit     Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resident Resident?        @relation(fields: [residentId], references: [id], onDelete: SetNull)
  type     IncidentType     @relation(fields: [typeId], references: [id])
  actions  IncidentAction[]

  @@index([orgId, occurredAt])
}

model IncidentAction {
  id         String    @id @default(cuid())
  incidentId String
  title      String
  assigneeId String?
  dueAt      DateTime?
  doneAt     DateTime?
  doneById   String?
  taskId     String?
  incident   Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Platform ─────────────────────────

/// Unveränderbares Protokoll. UPDATE und DELETE sind per Trigger gesperrt (siehe Migration).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  orgId      String?
  userId     String?
  sessionId  String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  context    Json?

  @@index([orgId, at])
  @@index([entityType, entityId])
  /// Sicherheitsüberwachung (alle 5 Min., organisationsübergreifend) und Löschfristen filtern nur nach Zeit (PRD §66)
  @@index([at])
}

