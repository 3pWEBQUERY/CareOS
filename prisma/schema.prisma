  key     String
  enabled Boolean      @default(false)
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

/// Outbox der Domain Events (PRD §44). Treibt Echtzeit-Updates und Webhooks.
model DomainEvent {
  id        String       @id @default(cuid())
  orgId     String
  type      String
  unitId    String?
  residentId String?
  actorId   String?
  payload   Json         @default("{}")
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model AiInteraction {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  kind      String
  input     String
  output    String
  model     String
  accepted  Boolean?
  createdAt DateTime @default(now())
}

/// Strukturierte Formulare für die Fokusdokumentation (PRD §10.3, Admin → Formulare §45).
/// fields = [{ key, label, type, options?, unit?, min?, max?, required? }]. Einträge speichern
/// formKey, formVersion und Feldbezeichnungen als Momentaufnahme in Observation.structured.
model FormDefinition {
  id          String              @id @default(cuid())
  orgId       String
  key         String
  name        String
  category    ObservationCategory @default(care)
  description String?
  fields      Json                @default("[]")
  active      Boolean             @default(true)
  version     Int                 @default(1)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

/// Hintergrundjobs (src/lib/jobs.ts): ein Eintrag pro Ausführung. Retention schreibt je Organisation einen Eintrag.
model JobRun {
  id         String    @id @default(cuid())
  name       String
  orgId      String?
  /// schedule | manual
  trigger    String    @default("schedule")
  actorId    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  summary    Json?
  error      String?

  @@index([name, startedAt])
  @@index([orgId, name, startedAt])
}

/// Offline-Synchronisation (PRD §39): pro Offline-Vorgang ein Eintrag; id = Idempotenzschlüssel vom Gerät (UUID).
/// result enthält nur Kennungen und Konfliktgründe, keine Gesundheitsdaten.
model OfflineOp {
  id        String   @id
  userId    String
  orgId     String
  /// note | vitals | task | intake
  kind      String
  /// pending | applied | conflict | rejected
  status    String
  /// Dokumentierter Zeitpunkt auf dem Gerät
  at        DateTime
  result    Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
}

// ───────────────────────── Visite ─────────────────────────

enum VisitQuestionStatus {
  open
  answered
  withdrawn
}

/// Arztvisite (PRD §29): pro Person und Visite ein Eintrag mit Zusammenfassung (als Verlaufseintrag, Document Once).
model Visit {
  id            String   @id @default(cuid())
  orgId         String
  unitId        String
  residentId    String
  /// Termin der Visite (wird beim Abschluss als erledigt markiert)
  appointmentId String?
  physician     String?
  /// Konto der Ärztin/des Arztes (internes Konto oder Ärzteportal), sonst nur Freitext `physician`
  physicianId   String?
  at            DateTime @default(now())
  note          String?
  /// Automatisch geschriebener Verlaufseintrag (Kategorie physician)
  observationId String?
  createdById   String
  createdAt     DateTime @default(now())

  resident  Resident        @relation(fields: [residentId], references: [id], onDelete: Cascade)
  questions VisitQuestion[]
  orders    VisitOrder[]

  @@index([orgId, unitId, at])
  @@index([residentId, at])
}

/// Von der Pflege für die nächste Visite vorgemerkte Frage, optional mit Bezug auf Vitalwert oder Verlaufseintrag.
model VisitQuestion {
  id          String              @id @default(cuid())
  orgId       String
  residentId  String
  text        String
  /// vital | observation
  refType     String?
  refId       String?
  /// Kurztext des Bezugs zum Zeitpunkt der Erfassung (z. B. «BZ 11,8 mmol/l · 22.10. 14:10»)
  refLabel    String?
  status      VisitQuestionStatus @default(open)
  answer      String?
  visitId     String?
  createdById String
  createdAt   DateTime            @default(now())
  closedById  String?
  closedAt    DateTime?
  /// Escalate (PRD §49): offen über die Frist (Organization.settings.escalation.visitQuestionHours) – einmal gemeldet.
  escalatedAt DateTime?

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  visit    Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([residentId, status])
}

/// Ärztliche Anordnung aus einer Visite. Jede Anordnung erzeugt eine Aufgabe (Task.source = order, sourceId = id).
model VisitOrder {
  id         String    @id @default(cuid())
  visitId    String
  residentId String
  /// medication | lab | check | therapy | other
  kind       String
  text       String
  dueAt      DateTime?
  questionId String?
  taskId     String?
  createdAt  DateTime  @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([residentId])
}

/// Ärztliche Zuständigkeit (PRD §60 Ärzteportal): Konto ↔ Person, befristet. Quelle für «meine Patient/innen»
/// und für den Zugriff externer Ärztinnen und Ärzte (src/lib/md/scope.ts).
model ResidentPhysician {
  id          String    @id @default(cuid())
  orgId       String
  residentId  String
  userId      String
  /// primary (Haus-/Heimärztin) | consultant (Fach-/Konsiliarärztin)
  role        String    @default("primary")
  from        DateTime  @default(now())
  until       DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([residentId, userId])
  @@index([userId])
  @@index([orgId])
}

/// Therapieplan (PRD §60 Therapie): Physio-, Ergo-, Logotherapie, Aktivierung mit Ziel, Frequenz und Anleitung für die Pflege.
model TherapyPlan {
  id               String    @id @default(cuid())
  orgId            String
  unitId           String
  residentId       String
  /// physio | ergo | speech | activation
  discipline       String
  goal             String
  /// Einheiten pro Woche und Dauer je Einheit (Minuten)
  perWeek          Int       @default(1)
  sessionMin       Int       @default(30)
  /// Auftrag aus der Visite (VisitOrder.id), falls vorhanden
  orderId          String?
  therapistId      String?
  /// Anleitung für die Pflege (z. B. «Gehtraining mit Rollator»); erzeugt eine wiederkehrende Aufgabe (TaskTemplate)
  careInstructions String?
  careTemplateId   String?
  /// active | completed | stopped
  status           String    @default("active")
  startDate        DateTime  @default(now()) @db.Date
  endDate          DateTime? @db.Date
  /// Nächste Zielevaluation
  reviewAt         DateTime? @db.Date
  outcome          String?
  closedAt         DateTime?
  closedById       String?
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([orgId, unitId, status])
  @@index([residentId])
}

/// Apotheke (PRD §13.1 Bestandsmanagement, §40): Bestellung, Wareneingang mit Charge/Verfall und Korrektur je Verordnung.
model MedicationStockEntry {
  id           String     @id @default(cuid())
  orgId        String
  unitId       String
  medicationId String
  residentId   String
  /// order (bestellt) | receipt (Wareneingang) | correction (Bestandskorrektur)
  kind         String
  /// Menge in der Bestandseinheit der Verordnung (order/receipt > 0, correction ±)
  quantity     Int
  /// nur order: open | received | cancelled
  status       String?
  /// Wareneingang zu einer Bestellung
  orderId      String?
  batch        String?
  expiry       DateTime?  @db.Date
  note         String?
  /// Bestand nach der Buchung (receipt/correction)
  stockAfter   Int?
  byId         String
  at           DateTime   @default(now())

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([orgId, unitId, kind, status])
  @@index([medicationId, at])
}

// ───────────────────────── Plattform und Sicherheit ─────────────────────────

/// Rate-Limit über alle Instanzen (src/lib/rate-limit.ts): Fixed Window. key = Namensraum + SHA-256 (keine E-Mail/IP im Klartext).
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

/// Alarm aus der Audit-Überwachung (PRD §37, src/lib/security-alerts.ts, Job «security»).
model SecurityAlert {
  id          String    @id @default(cuid())
  orgId       String
  /// login_failures | mfa_failures | mass_access | export | permission_change | api_failures
  rule        String
  /// critical | warning | info
  severity    String
  /// Auslösende Person, falls bekannt
  userId      String?
  /// Gruppierung innerhalb der Regel (Person, IP- oder E-Mail-Hash)
  subject     String
  count       Int
  windowStart DateTime
  windowEnd   DateTime
  /// Nur Kennungen und Zählwerte, keine Gesundheitsdaten
  details     Json      @default("{}")
  /// open | acknowledged | resolved | false_positive
  status      String    @default("open")
  handledById String?
  handledAt   DateTime?
  note        String?
  incidentId  String?
  createdAt   DateTime  @default(now())

  @@unique([orgId, rule, subject, windowStart])
  @@index([orgId, status, createdAt])
}

/// Register der Datenschutz- und Sicherheitsvorfälle (PRD §36): Meldung, Bewertung, Meldepflicht (EDÖB, betroffene Personen).
model SecurityIncident {
  id                  String    @id @default(cuid())
  orgId               String
  /// Fortlaufende Nummer je Organisation
  number              Int
  title               String
  /// confidentiality | integrity | availability
  kind                String
  description         String
  discoveredAt        DateTime
  occurredAt          DateTime?
  /// low | medium | high
  risk                String    @default("medium")
  dataCategories      String[]
  affectedCount       Int?
  measures            String?
  /// open | assessed | reported | closed
  status              String    @default("open")
  /// Meldung an die Aufsichtsbehörde nötig (Art. 24 DSG / Art. 33 DSGVO)
  authorityRequired   Boolean?
  authorityNotifiedAt DateTime?
  subjectsRequired    Boolean?
  subjectsNotifiedAt  DateTime?
  reportedById        String
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
}

/// Ausführungsprotokoll der Integrationen (PRD §40/§41, src/lib/integrations/registry.ts).
model IntegrationRun {
  id            String    @id @default(cuid())
  orgId         String
  integrationId String
  /// test | import | export
  operation     String
  /// manual | schedule | api
  trigger       String    @default("manual")
  actorId       String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  ok            Boolean?
  records       Int       @default(0)
  /// Nur Zählwerte und Kennungen, keine Gesundheitsdaten
  summary       Json?
  error         String?

  @@index([integrationId, startedAt])
  @@index([orgId, startedAt])
}

/// Laborbefunde (PRD §40): Import über eine Labor-Integration (Schnittstelle vorbereitet).
model LabResult {
  id            String   @id @default(cuid())
  orgId         String
  residentId    String
  integrationId String?
  externalId    String?
  /// LOINC oder Laborcode
  code          String?
  name          String
  value         String
  numeric       Float?
  unit          String?
  refRange      String?
  /// normal | low | high | critical | abnormal
  flag          String?
  collectedAt   DateTime
  receivedAt    DateTime @default(now())
  note          String?

  @@unique([orgId, integrationId, externalId])
  @@index([residentId, collectedAt])
}

/// In-App-Rückmeldung (PRD §62–§64): Problem, Idee, Kurzbewertung. Personenbezug nur, wenn die Person ihn wählt.
model Feedback {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  /// problem | idea | rating
  kind      String
  /// 1–5 (Kurzbewertung)
  rating    Int?
  text      String?
  /// Ansicht ohne Kennungen (z. B. /residents/:id/vitals)
  path      String?
  /// new | seen | done
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

/// Serverfehler aus onRequestError (src/instrumentation.ts), je Tag und Fingerabdruck gezählt.
/// Ohne Fehlermeldung und ohne Anfragedaten (können Personendaten enthalten); Details stehen im Log (digest).
model ErrorEvent {
  id          String   @id @default(cuid())
  day         DateTime @db.Date
  /// SHA-256 aus Fehlername, Route und erster Stack-Zeile
  fingerprint String
  name        String
  /// Routenmuster, z. B. /residents/[id]/vitals
  route       String
  /// render | route | action | proxy | job
  routeType   String
  method      String?
  digest      String?
  count       Int      @default(1)
  firstAt     DateTime @default(now())
  lastAt      DateTime @default(now())

  @@unique([day, fingerprint])
  @@index([lastAt])
}

// ───────────────────────── Angehörigenportal (PRD §60, §36) ─────────────────────────
// Eigene Konten und Sitzungen, getrennt von User/Session: keine Rollen, kein Zugang zur Stationsapp.
// Der Bewohnerbezug entsteht nur über PortalAccess (src/lib/portal/context.ts); was sichtbar ist, regelt src/lib/portal/policy.ts.

/// Konto im Angehörigenportal (/portal). E-Mail je Organisation eindeutig.
model PortalAccount {
  id           String    @id @default(cuid())
  orgId        String
  email        String
  name         String
  phone        String?
  passwordHash String?
  locale       Locale    @default(de)
  /// Zweiter Faktor (TOTP) optional, Geheimnis verschlüsselt (src/lib/crypto.ts)
  mfaSecret    String?
  mfaEnabled   Boolean   @default(false)
  /// Durch die Organisation gesperrt (Team → Angehörige); Sitzungen werden dabei widerrufen.
  lockedAt     DateTime?
  lockedById   String?
  lastLoginAt  DateTime?
  /// Schriftgrösse des Kontos (m | l | xl, src/lib/theme.ts); wird bei der Anmeldung auf das Gerät übernommen
  textSize     String?
  createdAt    DateTime  @default(now())

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions PortalSession[]
  accesses PortalAccess[]

  @@unique([orgId, email])
}

/// Sitzung im Portal (Cookie careos_portal, Pfad /portal). Nie mit Session der Mitarbeitenden austauschbar.
model PortalSession {
  id         String    @id @default(cuid())
  accountId  String
  tokenHash  String    @unique
  mfaPassed  Boolean   @default(false)
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  account PortalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// Zugang einer Person zu einer/einem Bewohnenden: Einladung, Einwilligung, Freigaben, Widerruf.
model PortalAccess {
  id              String    @id @default(cuid())
  orgId           String
  residentId      String
  /// gesetzt, sobald die Einladung angenommen ist
  accountId       String?
  contactId       String?
  /// relative | legal_rep | self (Bewohnerportal: die Person selbst, ohne Kontakt)
  role            String    @default("relative")
  /// Freigaben: appointments | updates | messages | visits | files (nie klinische Daten)
  grants          String[]  @default([])
  inviteEmail     String
  inviteName      String
  /// SHA-256 des Einmal-Links; nach Annahme null
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  invitedById     String
  acceptedAt      DateTime?
  /// Einwilligung: resident (die Person selbst) | legal_rep (gesetzliche Vertretung)
  consentBy       String
  consentName     String
  consentAt       DateTime
  /// Umfang der Einwilligung; Freigaben liegen immer innerhalb
  consentScope    String[]  @default([])
  consentNote     String?
  /// Mitarbeitende/r, die/der die Einwilligung erfasst hat
  consentById     String
  revokedAt       DateTime?
  revokedById     String?
  revokeReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  resident Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  account  PortalAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact  Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  threads  PortalThread[]
  visits   VisitRequest[]

  @@index([orgId, residentId])
  @@index([accountId])
}

/// Nachricht von Angehörigen an das Team (Posteingang Team → Angehörige).
model PortalThread {
  id            String    @id @default(cuid())
  orgId         String
  residentId    String
  accessId      String?
  subject       String
  /// open | answered | closed
  status        String    @default("open")
  assigneeId    String?
  lastMessageAt DateTime  @default(now())
  staffReadAt   DateTime?
  familyReadAt  DateTime?
  createdAt     DateTime  @default(now())

  resident Resident        @relation(fields: [residentId], references: [id], onDelete: Cascade)
  access   PortalAccess?   @relation(fields: [accessId], references: [id], onDelete: SetNull)
  messages PortalMessage[]

  @@index([orgId, status, lastMessageAt])
  @@index([residentId])
}

model PortalMessage {
  id            String   @id @default(cuid())
  threadId      String
  /// family | staff
  side          String
  accountId     String?
  userId        String?
  body          String
  /// in den Verlauf übernommen (Observation, Kategorie relatives)
  observationId String?
  createdAt     DateTime @default(now())

  thread PortalThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// Mitteilung der Station für Angehörige (eigene Kategorie, nie aus Verlauf oder Team-Mitteilungen abgeleitet).
/// residentId null = an alle Angehörigen des Bereichs (unitId) bzw. der Organisation (beide null).
model PortalUpdate {
  id          String    @id @default(cuid())
  orgId       String
  unitId      String?
  residentId  String?
  title       String
  body        String
  fileIds     String[]  @default([])
  /// Für wen: family (Angehörige) | residents (Bewohnende selbst) | all
  audience    String    @default("family")
  authorId    String
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  resident Resident? @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([orgId, publishedAt])
}

/// Besuchsanfrage aus dem Portal; bestätigt → Appointment kind relatives.
model VisitRequest {
  id            String    @id @default(cuid())
  orgId         String
  residentId    String
  accessId      String?
  start         DateTime
  end           DateTime
  visitors      Int       @default(1)
  /// Name der Besuchenden, wenn die Person selbst einen Besuch anmeldet (Bewohnerportal)
  visitorName   String?
  note          String?
  /// requested | confirmed | declined | cancelled
  status        String    @default("requested")
  assigneeId    String?
  reply         String?
  decidedById   String?
  decidedAt     DateTime?
  appointmentId String?
  staffReadAt   DateTime?
  createdAt     DateTime  @default(now())

  resident Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  access   PortalAccess? @relation(fields: [accessId], references: [id], onDelete: SetNull)

  @@index([orgId, status, start])
  @@index([residentId])
}

/// Notfallzugriff (PRD §34/§37, «Break Glass»): befristeter Lesezugriff auf klinische Daten für Personen ohne klinische Rolle.
/// Begründung Pflicht, jeder Zugriff im Audit-Protokoll, Benachrichtigung an Pflegedienstleitung und Datenschutz.
model EmergencyAccess {
  id         String    @id @default(cuid())
  orgId      String
  userId     String
  reason     String
  startedAt  DateTime  @default(now())
  expiresAt  DateTime
  endedAt    DateTime?
  endedById  String?
  sessionId  String?
  /// Anzahl protokollierter Seitenaufrufe während des Zugriffs
  views      Int       @default(0)

  @@index([orgId, startedAt])
  @@index([userId, expiresAt])
}
