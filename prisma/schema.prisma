// CareOS – Datenmodell
// Domains gemäss PRD §43: Identity, Organization, Workforce, Resident, Clinical,
// Workflow, Communication, Knowledge, Quality, Platform.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Locale {
  de
  fr
  it
  en
}

enum ThemePref {
  light
  dark
  system
}

enum Terminology {
  resident
  patient
  client
}

enum ReaStatus {
  yes
  no
  unknown
}

enum ResidentStatus {
  active
  absent
  discharged
  deceased
}

enum Priority {
  critical
  important
  routine
}

enum NotificationPriority {
  critical
  action
  info
  social
}

enum TaskStatus {
  planned
  ready
  in_progress
  done
  partial
  skipped
  escalated
}

enum TaskSource {
  careplan
  medication
  assessment
  order
  quality
  manual
  recurring
  event
}

enum ObservationCategory {
  care
  observation
  physician
  relatives
  incident
  handover
}

enum EntrySource {
  manual
  task
  voice
  ai
  system
}

enum CarePlanStatus {
  draft
  active
  archived
}

enum MedicationKind {
  regular
  prn
  temporary
}

enum AdministrationStatus {
  given
  refused
  omitted
  held
}

enum WoundStatus {
  open
  healing
  closed
}

enum IncidentStage {
  reported
  immediate
  assessment
  followup
  analysis
  closed
}

enum Severity {
  none
  minor
  moderate
  severe
}

enum DocStatus {
  draft
  review
  approved
  archived
}

enum EnrollmentStatus {
  assigned
  in_progress
  completed
  expired
}

enum ShiftStatus {
  planned
  open
  swap_requested
  cancelled
}

enum AbsenceKind {
  vacation
  sick
  training
  compensation
  other
}

enum ApprovalStatus {
  requested
  approved
  rejected
}

enum ConversationKind {
  direct
  group
  team
}

enum ChannelKind {
  company
  location
  unit
  care
  admin
  events
  offers
  custom
}

// ───────────────────────── Organization ─────────────────────────

model Organization {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  terminology   Terminology @default(resident)
  defaultLocale Locale      @default(de)
  timezone      String      @default("Europe/Zurich")
  dataRegion    String      @default("eu-central")
  brandColor    String?
  brandName     String?
  logoFileId    String?
  settings      Json        @default("{}")
  createdAt     DateTime    @default(now())

  locations      Location[]
  units          Unit[]
  teams          Team[]
  users          User[]
  roles          Role[]
  residents      Resident[]
  shiftTypes     ShiftType[]
  qualifications Qualification[]
  channels       Channel[]
  conversations  Conversation[]
  documents      Document[]
  courses        Course[]
  incidentTypes  IncidentType[]
  incidents      Incident[]
  files          FileObject[]
  integrations   Integration[]
  webhooks       Webhook[]
  featureFlags   FeatureFlag[]
  apiTokens      ApiToken[]
  vitalLimits    VitalThreshold[]
  careDomains    CareDomain[]
  assessmentDefs AssessmentDefinition[]
  tasks          Task[]
  events         DomainEvent[]
}

model Location {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  org     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  units   Unit[]
  roles   RoleAssignment[]
  channel Channel[]

  @@index([orgId])
}

model Unit {
  id         String   @id @default(cuid())
  orgId      String
  locationId String
  name       String
  shortName  String?
  kind       String   @default("ward")
  createdAt  DateTime @default(now())

  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  rooms      Room[]
  residents  Resident[]
  teams      Team[]
  roles      RoleAssignment[]
  shifts     Shift[]
  handovers  Handover[]
  tasks      Task[]
  channels   Channel[]
  incidents  Incident[]

  @@index([orgId])
  @@index([locationId])
}

model Room {
  id        String     @id @default(cuid())
  unitId    String
  number    String
  beds      Int        @default(1)
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  residents Resident[]

  @@unique([unitId, number])
}

model Team {
  id        String       @id @default(cuid())
  orgId     String
  unitId    String?
  name      String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit      Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  members   TeamMember[]

  @@index([orgId])
}

model TeamMember {
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id           String    @id @default(cuid())
  orgId        String
  email        String    @unique
  firstName    String
  lastName     String
  initials     String
  jobTitle     String?
  employeeNo   String?
  phone        String?
  passwordHash String?
  locale       Locale    @default(de)
  theme        ThemePref @default(light)
  mfaSecret    String?
  mfaEnabled   Boolean   @default(false)
  ssoSubject   String?   @unique
  avatarFileId String?
  active       Boolean   @default(true)
  primaryUnitId String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  org             Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessions        Session[]
  passkeys        Passkey[]
  roles           RoleAssignment[]
  teams           TeamMember[]
  shifts          Shift[]
  absences        Absence[]           @relation("AbsenceUser")
  qualifications  UserQualification[]
  notifications   Notification[]
  acknowledgements Acknowledgement[]
  enrollments     Enrollment[]
  certificates    Certificate[]
  conversationMembers ConversationMember[]
  messages        Message[]
  posts           Post[]
  primaryResidents Resident[]         @relation("PrimaryNurse")

  @@index([orgId])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  mfaPassed   Boolean   @default(false)
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthChallenge {
  id        String   @id @default(cuid())
  userId    String?
  challenge String
  kind      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Role {
  id          String           @id @default(cuid())
  orgId       String
  key         String
  name        String
  description String?
  permissions String[]
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]

  @@unique([orgId, key])
}

/// Rolle mit optionalem Geltungsbereich. Ohne Standort/Bereich gilt sie für die ganze Organisation.
model RoleAssignment {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  locationId String?
  unitId     String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiToken {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  tokenHash   String    @unique
  scopes      String[]
  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Workforce ─────────────────────────

model ShiftType {
  id      String       @id @default(cuid())
  orgId   String
  code    String
  name    String
  start   String
  end     String
  color   String       @default("accent")
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shifts  Shift[]

  @@unique([orgId, code])
}

model Shift {
  id          String      @id @default(cuid())
  unitId      String
  userId      String?
  shiftTypeId String
  date        DateTime    @db.Date
  status      ShiftStatus @default(planned)
  note        String?
  requiredQualification String?
  createdAt   DateTime    @default(now())

  unit      Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  shiftType ShiftType     @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  swaps     SwapRequest[]

  @@index([unitId, date])
  @@index([userId, date])
}

model SwapRequest {
  id           String         @id @default(cuid())
  shiftId      String
  requesterId  String
  takerId      String?
  status       ApprovalStatus @default(requested)
  note         String?
  createdAt    DateTime       @default(now())
  decidedById  String?
  decidedAt    DateTime?

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

model Absence {
  id          String         @id @default(cuid())
  userId      String
  kind        AbsenceKind
  from        DateTime       @db.Date
  to          DateTime       @db.Date
  status      ApprovalStatus @default(requested)
  note        String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  user User @relation("AbsenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Qualification {
  id     String              @id @default(cuid())
  orgId  String
  name   String
  level  Int                 @default(1)
  org    Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users  UserQualification[]
}

model UserQualification {
  userId          String
  qualificationId String
  validUntil      DateTime?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  @@id([userId, qualificationId])
}

// ───────────────────────── Resident ─────────────────────────

model Resident {
  id             String         @id @default(cuid())
  orgId          String
  unitId         String
  roomId         String?
  firstName      String
  lastName       String
  birthDate      DateTime       @db.Date
  sex            String?
  careLevel      Int?
  physician      String?
  primaryNurseId String?
  rea            ReaStatus      @default(unknown)
  allergies      String[]
  risks          String[]
  diet           String?
  mobility       String?
  importantNotes String?
  insuranceNo    String?
  status         ResidentStatus @default(active)
  admittedAt     DateTime       @default(now())
  dischargedAt   DateTime?
  photoFileId    String?
  createdAt      DateTime       @default(now())

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id])
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  primaryNurse User?        @relation("PrimaryNurse", fields: [primaryNurseId], references: [id], onDelete: SetNull)

  contacts        Contact[]
  episodes        CareEpisode[]
  appointments    Appointment[]
  observations    Observation[]
  vitals          VitalSign[]
  vitalLimits     VitalThreshold[]
  carePlans       CarePlan[]
  interventions   Intervention[]
  assessments     Assessment[]
  wounds          Wound[]
  nutrition       NutritionProfile?
  intake          IntakeLog[]
  medications     Medication[]
  administrations MedicationAdministration[]
  tasks           Task[]
  handoverEntries HandoverEntry[]
  incidents       Incident[]
  files           ResidentFile[]

  @@index([orgId, unitId])
}

model Contact {
  id          String   @id @default(cuid())
  residentId  String
  name        String
  relation    String
  phone       String?
  email       String?
  isEmergency Boolean  @default(false)
  isLegalRep  Boolean  @default(false)
  notes       String?
  resident    Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

model CareEpisode {
  id         String    @id @default(cuid())
  residentId String
  start      DateTime
  end        DateTime?
  reason     String
  resident   Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

model Appointment {
  id          String   @id @default(cuid())
  residentId  String
  at          DateTime
  title       String
  kind        String   @default("other")
  place       String?
  notes       String?
  done        Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  resident    Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, at])
}

model ResidentFile {
  id         String     @id @default(cuid())
  residentId String
  fileId     String
  title      String
  category   String     @default("other")
  createdAt  DateTime   @default(now())
  resident   Resident   @relation(fields: [residentId], references: [id], onDelete: Cascade)
  file       FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Clinical ─────────────────────────

/// Pflegebericht / Verlaufseintrag. Korrekturen erzeugen einen neuen Eintrag mit supersedesId.
model Observation {
  id           String              @id @default(cuid())
  residentId   String
  at           DateTime            @default(now())
  category     ObservationCategory
  text         String
  authorId     String
  source       EntrySource         @default(manual)
  aiAssisted   Boolean             @default(false)
  important    Boolean             @default(false)
  taskId       String?
  supersedesId String?
  structured   Json?
  createdAt    DateTime            @default(now())

  resident   Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)
  supersedes Observation? @relation("Correction", fields: [supersedesId], references: [id])
  correctedBy Observation[] @relation("Correction")

  @@index([residentId, at])
}

model VitalSign {
  id           String   @id @default(cuid())
  residentId   String
  at           DateTime @default(now())
  recordedById String
  sys          Int?
  dia          Int?
  pulse        Int?
  temp         Float?
  spo2         Int?
  glucose      Float?
  weight       Float?
  pain         Int?
  respRate     Int?
  note         String?
  resident     Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, at])
}

/// Grenzwert je Organisation (residentId leer) oder individuell je Bewohner.
model VitalThreshold {
  id         String       @id @default(cuid())
  orgId      String
  residentId String?
  key        String
  lo         Float
  hi         Float
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident   Resident?    @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([orgId, residentId, key])
}

model CareDomain {
  id     String       @id @default(cuid())
  orgId  String
  key    String
  name   String
  order  Int          @default(0)
  active Boolean      @default(true)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

model CarePlan {
  id             String         @id @default(cuid())
  residentId     String
  version        Int            @default(1)
  status         CarePlanStatus @default(draft)
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  nextEvaluation DateTime?
  createdAt      DateTime       @default(now())
  resident       Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  areas          CarePlanArea[]

  @@index([residentId])
}

model CarePlanArea {
  id          String         @id @default(cuid())
  carePlanId  String
  domain      String
  situation   String?
  resources   String?
  needs       String?
  risks       String?
  goal        String?
  evaluation  String?
  evaluateBy  DateTime?
  aiSuggested Boolean        @default(false)
  updatedAt   DateTime       @updatedAt
  carePlan    CarePlan       @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  interventions Intervention[]
}

/// Massnahme aus der Pflegeplanung; erzeugt täglich Aufgaben zu den angegebenen Zeiten.
model Intervention {
  id           String        @id @default(cuid())
  residentId   String
  areaId       String?
  title        String
  category     String
  times        String[]
  weekdays     Int[]
  durationMin  Int           @default(10)
  instructions String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  resident     Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  area         CarePlanArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
}

model AssessmentDefinition {
  id          String       @id @default(cuid())
  orgId       String
  key         String
  name        String
  description String?
  items       Json
  intervalDays Int?
  active      Boolean      @default(true)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

model Assessment {
  id         String   @id @default(cuid())
  residentId String
  key        String
  at         DateTime @default(now())
  score      Float?
  result     String?
  answers    Json
  authorId   String
  nextDue    DateTime?
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, key])
}

model Wound {
  id             String             @id @default(cuid())
  residentId     String
  bodySite       String
  kind           String
  classification String?
  origin         String?
  status         WoundStatus        @default(open)
  startedAt      DateTime           @default(now())
  closedAt       DateTime?
  createdById    String
  resident       Resident           @relation(fields: [residentId], references: [id], onDelete: Cascade)
  entries        WoundAssessment[]
}

model WoundAssessment {
  id          String    @id @default(cuid())
  woundId     String
  at          DateTime  @default(now())
  lengthMm    Float?
  widthMm     Float?
  depthMm     Float?
  exudate     String?
  tissue      String?
  edge        String?
  pain        Int?
  description String?
  treatment   String?
  material    String?
  nextChange  DateTime?
  photoIds    String[]
  authorId    String
  wound       Wound     @relation(fields: [woundId], references: [id], onDelete: Cascade)
}

model NutritionProfile {
  residentId    String   @id
  dietForm      String?
  texture       String?
  intolerances  String[]
  supplements   String?
  swallowing    String?
  fluidTargetMl Int?
  notes         String?
  updatedAt     DateTime @updatedAt
  resident      Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
}

model IntakeLog {
  id         String   @id @default(cuid())
  residentId String
  at         DateTime @default(now())
  kind       String
  item       String?
  amountMl   Int?
  portion    Float?
  authorId   String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, at])
}

// ───────────────────────── Medication ─────────────────────────

model Medication {
  id                  String         @id @default(cuid())
  residentId          String
  name                String
  form                String?
  route               String         @default("p.o.")
  indication          String?
  kind                MedicationKind @default(regular)
  /// Zeitpunkte HH:MM und Dosis je Zeitpunkt (gleiche Länge).
  times               String[]
  doses               String[]
  prnDose             String?
  prnMaxPerDay        Int?
  prnMinIntervalH     Int?
  startDate           DateTime       @default(now())
  endDate             DateTime?
  prescriber          String?
  requiresDoubleCheck Boolean        @default(false)
  stock               Int?
  stockUnit           String?
  notes               String?
  active              Boolean        @default(true)
  createdById         String
  createdAt           DateTime       @default(now())
  stoppedAt           DateTime?
  stoppedById         String?

  resident        Resident                   @relation(fields: [residentId], references: [id], onDelete: Cascade)
  administrations MedicationAdministration[]

  @@index([residentId])
}

model MedicationAdministration {
  id            String               @id @default(cuid())
  medicationId  String
  residentId    String
  /// Geplanter Zeitpunkt (null bei Reserve)
  scheduledFor  DateTime?
  status        AdministrationStatus
  dose          String?
  at            DateTime             @default(now())
  byId          String
  checkedById   String?
  note          String?
  effectAt      DateTime?
  effectNote    String?
  voidedAt      DateTime?
  voidedById    String?

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  resident   Resident   @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@index([residentId, scheduledFor])
  @@index([medicationId, at])
}

// ───────────────────────── Workflow ─────────────────────────

model Task {
  id             String     @id @default(cuid())
  orgId          String
  unitId         String
  residentId     String?
  title          String
  description    String?
  category       String
  dueAt          DateTime
  durationMin    Int        @default(10)
  priority       Priority   @default(routine)
  status         TaskStatus @default(planned)
  source         TaskSource @default(manual)
  sourceId       String?
  assigneeId     String?
  createdById    String?
  completedById  String?
  completedAt    DateTime?
  note           String?
  createdAt      DateTime   @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit     Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resident Resident?    @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId, dueAt])
  @@index([unitId, dueAt])
  @@index([residentId, dueAt])
}

model Handover {
  id          String          @id @default(cuid())
  unitId      String
  shiftCode   String
  date        DateTime        @db.Date
  authorId    String?
  note        String?
  submittedAt DateTime?
  createdAt   DateTime        @default(now())
  unit        Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  entries     HandoverEntry[]

  @@unique([unitId, shiftCode, date])
}

model HandoverEntry {
  id         String   @id @default(cuid())
  handoverId String
  residentId String
  watch      String?
  open       String?
  important  Boolean  @default(false)
  authorId   String
  updatedAt  DateTime @updatedAt
  handover   Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([handoverId, residentId])
}

/// Generische Kenntnisnahme: Übergabe, Mitteilung, Dokumentversion, wichtige Beobachtung.
model Acknowledgement {
  id          String   @id @default(cuid())
  userId      String
  subjectType String
  subjectId   String
  version     String   @default("")
  at          DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectType, subjectId, version])
  @@index([subjectType, subjectId])
}

// ───────────────────────── Communication ─────────────────────────

model Channel {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  kind        ChannelKind
  description String?
  locationId  String?
  unitId      String?
  postRoles   String[]
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  unit     Unit?        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  posts    Post[]
}

model Post {
  id          String    @id @default(cuid())
  channelId   String
  authorId    String
  title       String
  body        String
  important   Boolean   @default(false)
  requireAck  Boolean   @default(false)
  pinned      Boolean   @default(false)
  eventAt     DateTime?
  eventPlace  String?
  fileIds     String[]
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?

  channel  Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id])
  comments PostComment[]

  @@index([channelId, publishedAt])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String           @id @default(cuid())
  orgId       String
  kind        ConversationKind
  name        String?
  clinical    Boolean          @default(false)
  createdById String
  createdAt   DateTime         @default(now())
  lastMessageAt DateTime       @default(now())

  org      Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  muted          Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  fileIds        String[]
  mentions       String[]
  createdAt      DateTime          @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User              @relation(fields: [authorId], references: [id])
  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
}

model MessageReaction {
  messageId String
  userId    String
  emoji     String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  priority  NotificationPriority
  kind      String
  title     String
  body      String?
  href      String?
  groupKey  String?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ───────────────────────── Knowledge ─────────────────────────

model Document {
  id          String            @id @default(cuid())
  orgId       String
  title       String
  category    String
  tags        String[]
  status      DocStatus         @default(draft)
  ownerId     String
  requireAck  Boolean           @default(false)
  validFrom   DateTime?
  validUntil  DateTime?
  currentVersion String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions    DocumentVersion[]

  @@index([orgId, category])
}

model DocumentVersion {
  id           String    @id @default(cuid())
  documentId   String
  version      String
  body         String
  fileId       String?
  changeNote   String?
  critical     Boolean   @default(false)
  authorId     String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
}

model Course {
  id             String         @id @default(cuid())
  orgId          String
  title          String
  description    String?
  category       String         @default("general")
  mandatory      Boolean        @default(false)
  validityMonths Int?
  estMinutes     Int            @default(30)
  audienceRoles  String[]
  published      Boolean        @default(true)
  createdAt      DateTime       @default(now())
  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  modules        CourseModule[]
  enrollments    Enrollment[]
}

model CourseModule {
  id       String  @id @default(cuid())
  courseId String
  order    Int
  kind     String
  title    String
  body     String?
  fileId   String?
  videoUrl String?
  quiz     Json?
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id          String           @id @default(cuid())
  courseId    String
  userId      String
  status      EnrollmentStatus @default(assigned)
  assignedAt  DateTime         @default(now())
  dueAt       DateTime?
  doneModules String[]
  score       Float?
  completedAt DateTime?
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

model Certificate {
  id        String    @id @default(cuid())
  userId    String
  courseId  String?
  title     String
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?
  fileId    String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Quality ─────────────────────────

model IncidentType {
  id        String       @id @default(cuid())
  orgId     String
  key       String
  name      String
  /// Folgeprozess: [{ title, category, offsetMin, durationMin }]
  workflow  Json         @default("[]")
  active    Boolean      @default(true)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  incidents Incident[]

  @@unique([orgId, key])
}

model Incident {
  id               String        @id @default(cuid())
  orgId            String
  unitId           String
  residentId       String?
  typeId           String
  occurredAt       DateTime
  place            String?
  description      String
  immediateActions String?
  severity         Severity      @default(none)
  nearMiss         Boolean       @default(false)
  stage            IncidentStage @default(reported)
  assessment       String?
  analysis         String?
  conclusion       String?
  reportedById     String
  closedById       String?
  closedAt         DateTime?
  createdAt        DateTime      @default(now())

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit     Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resident Resident?        @relation(fields: [residentId], references: [id], onDelete: SetNull)
  type     IncidentType     @relation(fields: [typeId], references: [id])
  actions  IncidentAction[]

  @@index([orgId, occurredAt])
}

model IncidentAction {
  id         String    @id @default(cuid())
  incidentId String
  title      String
  assigneeId String?
  dueAt      DateTime?
  doneAt     DateTime?
  doneById   String?
  taskId     String?
  incident   Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Platform ─────────────────────────

/// Unveränderbares Protokoll. UPDATE und DELETE sind per Trigger gesperrt (siehe Migration).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  orgId      String?
  userId     String?
  sessionId  String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  context    Json?

  @@index([orgId, at])
  @@index([entityType, entityId])
}

model FileObject {
  id           String         @id @default(cuid())
  orgId        String
  key          String         @unique
  filename     String
  contentType  String
  size         Int
  purpose      String
  clinical     Boolean        @default(false)
  uploadedById String
  createdAt    DateTime       @default(now())
  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  residentFiles ResidentFile[]
}

model Integration {
  id        String       @id @default(cuid())
  orgId     String
  kind      String
  name      String
  config    Json         @default("{}")
  active    Boolean      @default(false)
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Webhook {
  id         String            @id @default(cuid())
  orgId      String
  url        String
  secret     String
  events     String[]
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  eventId    String
  status     Int?
  error      String?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

model FeatureFlag {
  id      String       @id @default(cuid())
  orgId   String
  key     String
  enabled Boolean      @default(false)
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

/// Outbox der Domain Events (PRD §44). Treibt Echtzeit-Updates und Webhooks.
model DomainEvent {
  id        String       @id @default(cuid())
  orgId     String
  type      String
  unitId    String?
  residentId String?
  actorId   String?
  payload   Json         @default("{}")
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model AiInteraction {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  kind      String
  input     String
  output    String
  model     String
  accepted  Boolean?
  createdAt DateTime @default(now())
}
